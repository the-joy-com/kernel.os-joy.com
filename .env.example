# Copy to `.env` and fill in.
# `.env` is gitignored and read at startup (config.py / load_dotenv),
# identically on a dev box and on the server —
# the only thing that differs between them is the values.

# --- database ---------------------------------------------------------------
# LOCAL (docker-compose): a TCP connection with a password.
DATABASE_URL=postgresql://joy:joy@localhost:5432/joy
# SERVER: leave DATABASE_URL pointing at the local Postgres via its unix socket,
# authenticated by peer auth (tied to the OS user the service runs as) —
# no host, no password.
# Create the database first as that user: `createdb $USER`.
# Then:
#   DATABASE_URL=postgresql:///$USER
# (Three slashes: empty host = default socket = peer auth as the current user.)

# The test suite uses its own database so it can truncate freely.
# Defaults to the DATABASE_URL's database with a `_test` suffix when unset.
# TEST_DATABASE_URL=postgresql://joy:joy@localhost:5432/joy_test

# Generation master switch.
# 1 → every generative call skips the cloud ladder and goes straight to Ollama,
# whatever provider the roles resolve to.
# Since the roles resolve to cloud ids Ollama can't serve,
# the call is substituted to the local floor GENERATIVE_LOCAL_FALLBACK_MODEL (qwen3.5:4b),
# unless a role already points at an Ollama model, which is honoured as-is.
# Touches generation only — embedding is always local,
# and login delivery stays governed by the GMAIL_* vars.
# The one-flag path to a fully-local box:
# with this set you needn't reassign the roles by hand.
# Pull the local model first (`ollama pull qwen3.5:4b`).
IS_LOCAL=0

# --- identity ---------------------------------------------------------------
# The human symbiot seeded into the `symbiot` table at startup.
# Today the single seeded address; the schema and /login already support more than one,
# so this is the first symbiot, not the only one there can ever be.
SYMBIOT_EMAIL=you@example.com

# Server-side secret used to HMAC login codes and session tokens before they touch the database,
# so a DB leak never exposes a usable code or token.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
KERNEL_SECRET=change-me-in-production

# --- abuse limits (all overridable; defaults shown and already active) -------
# These are NOT opt-in: every limit below ships on, with the default baked into config.py.
# Uncomment a line only to override its default —
# leaving the whole block commented does not disable anything.
# Minimum gap between two issued codes for one symbiot — caps email bombing,
# and stops a double-tap from invalidating the code already in the inbox.
# LOGIN_REISSUE_INTERVAL_SECONDS=60
# Wrong guesses a single live code absorbs before the database burns it.
# MAX_VERIFY_ATTEMPTS=3
# The edge rate limiter; on unless set to 0/false/no/off.
# The only limit here that can be switched fully off —
# the DB guarantees above stay enforced regardless.
# Behind nginx it needs `proxy_set_header X-Real-IP $remote_addr;` to key per-caller.
# RATE_LIMIT_ENABLED=true

# --- login code delivery (Gmail API, or a local file) -----------------------
# The login code has to reach a human.
# There are two ways, chosen by whether Gmail is wired:
#
# 1. Gmail (the hosted way): set both keys below and the code is emailed.
#    GMAIL_CREDENTIALS_FILE is the path to the GCP service-account JSON key (gitignored, never committed);
#    GMAIL_SENDER is the Workspace mailbox the service account impersonates / sends as.
GMAIL_CREDENTIALS_FILE=
GMAIL_SENDER=
#
# 2. Mailboxless (the fully-local way): leave both blank, and the code is written to a file on the box instead —
#    for a home server running everything on Ollama with no mail wiring at all.
#    The operator (who controls the box) reads the code straight off disk;
#    a console log line signposts that a code was written and where.
#    Defaults to OTP.txt at the repo root (gitignored) — set this only to point it elsewhere.
# OTP_FILE=OTP.txt
#
# The test suite ignores both and injects an in-memory fake,
# so the whole flow is exercised without credentials or a file on disk.

# --- persona ----------------------------------------------------------------
# The machine symbiot's voice, kept as two files (persona.py).
# The public half is versioned in the repo (persona/public.md) and holds the character;
# the private half (persona/private.md) is gitignored and holds what stays between you and your symbiot, 
# spliced into the {{ INJECT_SYMBIOSIS_CORE_PRIVATE }} slot of the public half.
# Both default to those repo paths; set these only to point them elsewhere.
# An absent private file is fine — the slot collapses and the public persona stands alone.
# PERSONA_PUBLIC_FILE=persona/public.md
# PERSONA_PRIVATE_FILE=persona/private.md
# The ground-rules preamble: the truth contract that leads every composed answer,
# and the front of the fixed, cacheable head every prose call shares (so a caching provider bills it once).
# Repo-versioned like the public persona — it holds nothing secret — and defaults to the repo path.
# PREAMBLE_FILE=persona/preamble.md

# --- web push (VAPID) -------------------------------------------------------
# The signing key for kernel-originated push notifications (the reply channel).
# When unset, the kernel simply sends no pushes —
# answers still store and /answers still serves them; only the tap-on-the-shoulder is skipped.
# The private key is the raw 32-octet scalar in base64url;
# the public application server key the browser subscribes with is derived from it at runtime,
# so only the private half is configured. Generate a pair with:
#   uv run python -c "import base64;from cryptography.hazmat.primitives.asymmetric import ec;k=ec.generate_private_key(ec.SECP256R1());print(base64.urlsafe_b64encode(k.private_numbers().private_value.to_bytes(32,'big')).decode().rstrip('='))"
VAPID_PRIVATE_KEY=
# A contact URI the push service can reach the app owner at (mailto: or https:).
VAPID_SUBJECT=mailto:you@example.com

# --- embedding (local Ollama) -----------------------------------------------
# Embedding stays on the box — its vector width is what the pgvector tables are typed to —
# so these point at the host's Ollama. Generation, by contrast, runs in the cloud
# (see the generative-providers block below) and only falls back here when both clouds are down.
# Every key below ships with a working default baked into config.py;
# uncomment one only to override it. A fresh clone embeds with zero of these set.
# Where the local Ollama listens (used by both the embedder and the generative fallback tier).
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# The embedding model the router routes with.
# Its 768-wide output is what the ontology_embedding_nomic_embed_text tables are typed to,
# and it must match the model seeded active in embedding_model (migration 0010) —
# change one without the other and facts are searched against vectors from a different model.
# EMBEDDING_MODEL=nomic-embed-text
# The context window opened on every embed call.
# Ollama clips nomic-embed-text to 2048 tokens by default and truncates in silence;
# 8192 is the model's native window, so a long text reaches its vector whole.
# EMBEDDING_NUM_CTX=8192
# How long to wait on an embed call — generous, since the first call after a cold load pays the load once.
# OLLAMA_TIMEOUT_SECONDS=60
# How wide a candidate pool the vector search hands the re-ranker —
# wide for recall, but no wider than the re-ranker can weigh well in one call,
# not as wide as the index could answer.
# RECALL_POOL=20
# The HNSW working-set width per query.
# Must stay >= RECALL_POOL, or recall is capped below the pool we ask back.
# RECALL_EF_SEARCH=100
# The two thresholds that band the top re-rank score into reuse / grey / mint.
# At or above REUSE_THRESHOLD the top type is reused; at or below MINT_THRESHOLD a new type is coined;
# the band between them escalates to the one-shot LLM gate.
# INVARIANT: 0.0 <= MINT_THRESHOLD < REUSE_THRESHOLD <= 1.0.
# Cross them and the kernel refuses to boot rather than silently mis-file every fact that follows.
# REUSE_THRESHOLD=0.7
# MINT_THRESHOLD=0.3

# --- ontology duplicate GC (offline, in-process) ----------------------------
# The sweep that collapses the semantic-duplicate types lazy minting breeds over time.
# It runs in-process on a slow cadence like the intake reconcile sweep — no external cron.
# On unless set to 0/false/no/off (the tests turn it off to drive the merge by hand).
# GC_ENABLED=true
# How often the sweep wakes. A day, not seconds — duplicates accrue slowly and this is off the read path.
# GC_SWEEP_INTERVAL_SECONDS=86400
# The cosine-distance pre-filter for nominating near-twin type pairs before the model confirms them.
# A loose net, not the verdict; widen it to catch synonyms that embed further apart.
# The by-hand smoke (test/qa/0002_ontology_gc_smoke.py) prints real distances to tune this against.
# GC_DISTANCE=0.2

# --- generative providers (cloud, with a local fallback) --------------------
# Every generative call — the router's judgments and the composed reply —
# runs on a bigger, faster model than the box can serve.
# The ladder, tried per request: Google/Gemini (the primary) → Scaleway → Mistral's web API → local Ollama (last resort).
# This sends the symbiot's own words to an external provider,
# a deliberate trade of the strictly-local stance for capability and speed.
#
# Google (Gemini) is the primary the roles resolve to, and answers in the steady state — the ladder only falls on an outage.
# It runs on the Agent Platform, authenticated by application-default credentials rather than an API key
# (a key routes to the consumer Developer API, not the enterprise, zero-retention Agent Platform).
# Leave GOOGLE_CLOUD_PROJECT empty and the Gemini rung is simply not wired,
# and every call falls straight through to Scaleway, exactly as the box behaved before this rung existed.
# The credential itself: point GOOGLE_APPLICATION_CREDENTIALS at a service-account JSON key,
# the same shape the Gmail path uses, and the google-auth search order reads it ahead of anything gcloud left on disk.
# This is what an unattended box needs. An interactive `gcloud auth application-default login`
# mints a *human's* credential whose refresh token Google expires on a policy schedule,
# and when it lapses the rung fails outage-class and the ladder falls silently to Scaleway —
# the machine keeps answering while the switch quietly undoes itself.
# A service account has no expiring refresh token: its key signs for a fresh access token on every call.
# The account needs Agent Platform inference on the project (roles/aiplatform.expressUser is enough).
# Gitignored by the `*-sa-creds.json` pattern — name the key to match, and never commit it.
# See doc/google-integration.md for standing the account up.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/joy-agent-platform-sa-creds.json
GOOGLE_CLOUD_PROJECT=some-project
GOOGLE_CLOUD_LOCATION=global
# Scaleway is reached through the OpenAI-compatible client it advertises.
SCALEWAY_API_BASE_URL=https://api.scaleway.ai/v1
SCALEWAY_API_KEY=some-key
# Mistral is reached at its own web API (not Scaleway's Mistral) through the official mistralai client.
MISTRAL_API_KEY=some-key
# The three tiers, each named by its primary — the Gemini model the roles resolve to.
# Unlike the rungs beneath, these are genuinely distinct: a real Gemini model at every tier.
# FLAGSHIP_MODEL=gemini-3.1-pro-preview
# MID_MODEL=gemini-3.6-flash
# SMALL_MODEL=gemini-3.5-flash-lite
# The Scaleway rung beneath each Gemini primary — where an outage-class failure on Google lands.
# The two cheaper tiers share one model here (SMALL defaults to MID).
# SCALEWAY_FLAGSHIP_MODEL=glm-5.2
# SCALEWAY_MID_MODEL=gpt-oss-120b
# SCALEWAY_SMALL_MODEL=gpt-oss-120b
# Beneath Scaleway, the cross-cloud Mistral catch of the same tier,
# and then, only if every cloud is down, the single local Ollama floor.
# MISTRAL_FLAGSHIP_MODEL=mistral-large-latest
# MISTRAL_MID_MODEL=ministral-8b-latest
# MISTRAL_SMALL_MODEL=ministral-8b-latest
# GENERATIVE_LOCAL_FALLBACK_MODEL=qwen3.5:4b
# What the local model's window costs the box, and how much of the box it may claim.
# Ollama allocates a window up front as a KV cache, so the same model holds far less on a laptop
# than on a workstation, and the usable figure is a fact about the hardware rather than about the model.
# With IS_LOCAL=1 the kernel measures it once, on first boot, by loading the model and reading back
# how Ollama placed it, then records the answer so no later boot pays for the probe again.
# LOCAL_WINDOW_MARGIN is the slice of the measured ceiling the window may not claim,
# left free for the buffers that grow with a longer prompt.
# LOCAL_WINDOW_TOKENS answers for the box by hand and skips the probe entirely —
# set it if you already know what your hardware holds, or if you would rather nothing loaded a model at startup.
# LOCAL_WINDOW_MARGIN=0.1
# LOCAL_WINDOW_TOKENS=
# Every generative role, each defaulting to the tier its work deserves rather than being named here.
# The reply takes the flagship, and the two long-form jobs downstream of it follow whatever the reply is set to;
# minting a type and the two tool judgments take the mid tier; the router's re-rank takes the small one.
# A role's provider is looked up from the model map (services/adapters/models.py),
# so pointing one at a local name (e.g. qwen3.5:4b) is the one-line rollback to on-box generation,
# and pointing one at a Scaleway model drops the Google rung for that role alone.
# The defaults below are what the tiers currently resolve to — shown, not set.
# CONVERSATION_COMPRESS_MODEL=gemini-3.1-pro-preview
# ENRICH_MODEL=gemini-3.1-pro-preview
# MINT_MODEL=gemini-3.6-flash
# REPLY_MODEL=gemini-3.1-pro-preview
# RERANK_MODEL=gemini-3.5-flash-lite
# TOOL_CONFIRM_MODEL=gemini-3.6-flash
# TOOL_DECISION_MODEL=gemini-3.6-flash
# How long to wait on a single generative attempt, applied per rung of the ladder — longer than an embed;
# the intake deadline is sized to clear four of these in sequence.
# LLM_TIMEOUT_SECONDS=120
